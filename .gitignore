# Local credentials; keep a sanitized example available for the team
.env
.env.*
!.env.example

# Crawled corpus, manual runs, logs and exported benchmark/report data
# Directory rules apply at any depth (including src/notebooks/data/).
# Put custom run roots under data/ so their outputs stay out of Git.
data/
downloads/
logs/
metrics/
milestone1_demo/
outputs/
report_data/
*.log

# Separate report checkout and local review notes are not part of the code repo.
/arXiv-report/
/docs/milestone1/RA_SOAT_TRUOC_KHI_NOP.md

# Incomplete downloads and temporary files
*.download
*.part
*.tmp
*.swp
*.swo
*~

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Keep source, notebooks, docs and requirements tracked.
# Do not ignore all JSON/CSV/TeX/BibTeX/archive files by extension:
# small deliberate test fixtures may need those formats.
# Notebook cell outputs must be cleared before commit; .gitignore cannot
# exclude outputs embedded inside a tracked .ipynb file.
